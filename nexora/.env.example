# ---- Database ----
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_password
POSTGRES_DB=nexora
DATABASE_URL=postgres://nexora:nexora_dev_password@postgres:5432/nexora?sslmode=disable

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Security ----
# Used to HMAC-hash API keys before storage (never store plaintext)
API_KEY_HMAC_SECRET=change_me_to_a_long_random_string

# ---- AI Providers (free tier) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Optional fallback provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- Service ports (internal, exposed for local dev convenience) ----
GATEWAY_PORT=8080
CUSTOMER_ACCESS_PORT=8081
OPERATIONS_PORT=8082
USAGE_WEBHOOKS_PORT=8083
CUSTOMER_DASHBOARD_PORT=3000
DUMMY_CUSTOMER_PORT=4000
